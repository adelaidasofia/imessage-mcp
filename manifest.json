{
  "manifest_version": "0.4",
  "name": "imessage-mcp",
  "display_name": "macOS-only MCP server that exposes iMessage chat",
  "version": "0.1.0",
  "description": "macOS-only MCP server that exposes iMessage chat.db to Claude and exports per-chat history to an Obsidian vault.",
  "author": {
    "name": "Adelaida Diaz-Roa",
    "url": "https://github.com/adelaidasofia"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adelaidasofia/imessage-mcp.git"
  },
  "homepage": "https://github.com/adelaidasofia/imessage-mcp",
  "documentation": "https://github.com/adelaidasofia/imessage-mcp#readme",
  "support": "https://github.com/adelaidasofia/imessage-mcp/issues",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "fastmcp",
    "imessage"
  ],
  "server": {
    "type": "python",
    "entry_point": "server.py",
    "mcp_config": {
      "command": "python3",
      "args": [
        "${__dirname}/server.py"
      ],
      "env": {}
    }
  },
  "tools_generated": true,
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin"
    ]
  }
}
